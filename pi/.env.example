# 이 파일을 .env 로 복사해 값을 채운다.
#   cp .env.example .env

# 웹 서비스 주소. 배포한 주소를 넣는다. 끝에 / 를 붙이지 않는다.
SERVER_URL=https://plant-web-alpha.vercel.app

# 식물 추가 3단계에서 받은 코드. 한 번만 보여주므로 여기 바로 붙여넣는다.
PLANT_TOKEN=pw_여기에_코드를_붙여넣으세요

# 온습도를 재는 간격(분). 기본 10분
READ_INTERVAL_MIN=10

# 사진 찍는 시각(시). 쉼표로 구분. 그날 10시 사진이 관찰일지의 대표 사진이 된다
PHOTO_HOURS=10,12,14,16

# DHT11 데이터 핀 (board 모듈 이름). GPIO4 면 D4
SENSOR_PIN=D4
